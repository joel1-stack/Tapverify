# TapVerify - Flutter app configuration
#
# The app takes its API base URL from a compile-time define, not a file.
#
# Run against a local backend:
#   flutter run --dart-define=API_BASE_URL=http://127.0.0.1:8000
#
# Android emulator talking to a backend on your machine:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000
#
# Release web build (must match the API host you deploy):
#   flutter build web --release --dart-define=API_BASE_URL=https://your-api-host
#
# vercel.json carries the same value for web deploys, so update it there too.
# If you leave the default in place, the published app will try to reach
# http://127.0.0.1:8000 on the visitor's own machine and nothing will load.
