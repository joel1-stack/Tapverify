# TapVerify Django Configuration
# Copy this to .env and fill in your real values

SECRET_KEY=your-django-secret-key-here-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL
DB_NAME=tapverify
DB_USER=tapverify
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Africa's Talking SMS
AFRICASTALKING_USERNAME=your_at_username
AFRICASTALKING_API_KEY=your_at_api_key
AFRICASTALKING_SENDER_ID=TAPVERIFY

# Receipt URLs
RECEIPT_BASE_URL=https://tverify.co.ke

# Active Payment Rail: 'loop' (primary) or 'payhero' (legacy)
ACTIVE_PAYMENT_RAIL=loop

# Loop API (primary rail)
LOOP_BASE_URL=https://sandbox.looponline.co.ke
LOOP_API_KEY=your_loop_api_key
LOOP_MERCHANT_ID=your_loop_merchant_id
LOOP_IPN_SECRET=your_loop_ipn_secret

# PayHero (legacy, secondary rail — optional)
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
