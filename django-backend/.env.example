# TapVerify Django Configuration
# Copy this to .env and fill in your real values

SECRET_KEY=your-django-secret-key-here-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL
DB_NAME=tapverify
DB_USER=tapverify
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Africa's Talking SMS
AFRICASTALKING_USERNAME=your_at_username
AFRICASTALKING_API_KEY=your_at_api_key
AFRICASTALKING_SENDER_ID=TAPVERIFY

# Receipt URLs
RECEIPT_BASE_URL=https://tverify.co.ke

# Active Payment Rail: 'loop' (primary) or 'payhero' (legacy)
ACTIVE_PAYMENT_RAIL=loop

# Loop API (primary rail) — LOOP Matrix gateway
LOOP_BASE_URL=https://sandbox.loop.co.ke
# OAuth2 token endpoint ($base + /oauth2/token by default).
LOOP_CONSUMER_KEY=your_consumer_key
LOOP_CONSUMER_SECRET=your_consumer_secret
# Leave blank to use the default gateway OAuth path: {base}/oauth2/token
LOOP_TOKEN_URL=
# Sandbox tills issued for the app: 133238 / 133239 / 133240 (all share one secret till)
LOOP_TILL=133239
LOOP_TILL_SECRET=your_sandbox_till_secret
LOOP_IPN_SECRET=

# PayHero (legacy, secondary rail — optional)
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
