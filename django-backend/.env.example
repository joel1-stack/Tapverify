# TapVerify V1 - Django configuration
# Copy this file to .env and fill in your real values.
# The app reads ONLY from .env - no secrets live in the code.

SECRET_KEY=your-django-secret-key-change-me
# DEBUG=True makes the OTP endpoint return the login code to the caller so you
# can log in without SMS. That is fine for a demo and fatal in production.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- SMS provider: sozuri | africastalking ---
# Whichever is selected, the other is kept as a fallback if not configured.
SMS_PROVIDER=sozuri

# --- Sozuri (OTP + member SMS) ---
SOZURI_ENDPOINT=https://sozuri.net/api/v1/messaging
SOZURI_API_KEY=your_sozuri_secret_api_key
SOZURI_PROJECT=your_sozuri_project_name
SOZURI_FROM=Sozuri
# "promotional" per the Sozuri example payload.
SOZURI_TYPE=promotional

# --- Africa's Talking (fallback) ---
AFRICASTALKING_USERNAME=your_at_username
AFRICASTALKING_API_KEY=your_at_api_key
AFRICASTALKING_SENDER_ID=TAPVERIFY
# True = use the AT sandbox endpoint (no real SMS delivered; the API
# response includes dev_code so you can still log in).
AFRICASTALKING_SANDBOX=True

# --- SasaPay (M-Pesa checkout + payment webhooks) ---
SASAPAY_BASE_URL=https://sandbox.sasapay.app
SASAPAY_CLIENT_ID=your_client_id
SASAPAY_CLIENT_SECRET=your_client_secret
SASAPAY_MERCHANT_CODE=your_merchant_code
SASAPAY_ACCOUNT_NUMBER=your_account_number
# Must include the /api prefix and the trailing slash, because that is the
# path Django serves. A wrong path silently means no payment is ever detected.
# Example: https://api.your-domain.co.ke/api/webhooks/sasapay/
SASAPAY_CALLBACK_URL=https://your-api-host/api/webhooks/sasapay/
# True = no real money moves; paying via a member link confirms instantly and
# the webhook accepts any caller. Perfect for a demo, unsafe for production.
SASAPAY_MOCK_MODE=True

# --- Member payment links ---
# Public base URL used to build the /p/<code>/ links sent by SMS. It must be a
# reachable HTTPS host serving this Django app, otherwise every SMS link 404s.
PAYMENT_LINK_BASE=http://127.0.0.1:8000
